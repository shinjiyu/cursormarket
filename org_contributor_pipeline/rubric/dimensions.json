        },
        {
          "id": "scale_reliability",
          "title_zh": "规模、并发与可用性",
          "title_en": "Scale & reliability",
          "observable_zh": "容量、限流、降级、多活/容灾目标与验证。"
        },
        {
          "id": "data_platform_patterns",
          "title_zh": "数据路径与中间件",
          "title_en": "Data path & middleware",
          "observable_zh": "缓存/MQ、顺序与重复消费、一致性与补偿。"
        },
        {
          "id": "state_consistency_cost",
          "title_zh": "状态、一致性与成本",
          "title_en": "State, consistency & cost",
          "observable_zh": "状态管理策略、一致性级别、扩缩容与费用意识。"
        }
      ]
    },
    {
      "id": "business_understanding",
      "title_zh": "业务理解能力",
      "title_en": "Business Understanding",
      "spirit_zh": "技术为业务服务：会问「为什么做、有无更省方案、是否动核心指标」。",
      "boss_focus_zh": "游戏场景下能对齐留存、付费、转化、运营、风险、投放等语境。",
      "level2": [
        {
          "id": "goals_users",
          "title_zh": "目标与用户",
          "title_en": "Goals & users",
          "observable_zh": "需求反讲、用户路径、体验取舍与数据反馈闭环。"
        },
        {
          "id": "roi_tradeoffs",
          "title_zh": "ROI 与方案取舍",
          "title_en": "ROI & tradeoffs",
          "observable_zh": "成本、排期、风险与收益的显式比较与记录。"
        },
        {
          "id": "game_context",
          "title_zh": "游戏业务语境",
          "title_en": "Game context",
          "observable_zh": "方案/排期与核心指标、活动或运营目标的关联表述。"
        }
      ]
    },
    {
      "id": "problem_solving",
      "title_zh": "问题解决能力",
      "title_en": "Problem Solving",
      "spirit_zh": "未知问题下的镇定、拆解与定位速度，比「背题」更值钱。",
      "level2": [
        {
          "id": "triage_throughput",
          "title_zh": "排查与闭环效率",
          "title_en": "Triage throughput",
          "observable_zh": "问题关闭时长、复盘、回归与验证链。"
        },
        {
          "id": "decomposition_rca",
          "title_zh": "拆解与根因",
          "title_en": "Decomposition & RCA",
          "observable_zh": "子问题树、假设顺序、证据链与最小复现。"
        },
        {
          "id": "methodology_under_fire",
          "title_zh": "方法论与压力下处理",
          "title_en": "Methodology under pressure",
          "observable_zh": "事故中的结构化输出、升级与止损、沉淀可复用清单。"
        }
      ]
    },
    {
      "id": "collaboration",
      "title_zh": "沟通与协作能力",
      "title_en": "Collaboration",
      "spirit_zh": "软件是团队工程；主程以后沟通与协同权重上升。",
      "level2": [
        {
          "id": "cross_functional",
          "title_zh": "跨职能协同",
          "title_en": "Cross-functional",
          "observable_zh": "与策划/产品/运营/美术等的接口、纪要与对齐频率。"
        },
        {
          "id": "requirements_docs",
          "title_zh": "需求澄清与文档",
          "title_en": "Requirements & docs",
          "observable_zh": "边界案例、验收标准、设计/交接文档可读性。"
        },
        {
          "id": "code_review_practice",
          "title_zh": "Code Review 实践",
          "title_en": "Code review",
          "observable_zh": "评审参与度、评论质量、缺陷闭环。"
        },
        {
          "id": "influence_mentoring",
          "title_zh": "影响、带人与向上沟通",
          "title_en": "Influence & mentoring",
          "observable_zh": "辅导记录、风险与依赖上报、对齐管理层预期。"
        }
      ]
    },
    {
      "id": "ownership",
      "title_zh": "主动性与 Ownership",
      "title_en": "Ownership",
      "spirit_zh": "主动暴露风险、推动落地，对结果负责，而非只完成分配条目。",
      "examples_zh": "从「需求没写」到「我已兜底/已同步风险」。",
      "level2": [
        {
          "id": "proactive_risk",
          "title_zh": "主动发现与暴露风险",
          "title_en": "Proactive risk",
          "observable_zh": "非分配范围内的改进、预警单、前置沟通。"
        },
        {
          "id": "drive_closure",
          "title_zh": "推动解决与闭环",
          "title_en": "Drive to closure",
          "observable_zh": "跨人推进、升级路径、可验证的完成定义。"
        },
        {
          "id": "outcome_accountability",
          "title_zh": "对结果负责",
          "title_en": "Outcome accountability",
          "observable_zh": "线上/里程碑结果、复盘中的承担与改进项。"
        }
