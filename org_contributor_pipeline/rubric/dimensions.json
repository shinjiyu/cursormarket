    },
    {
      "id": "growth",
      "title_zh": "学习与成长能力",
      "title_en": "Growth",
      "spirit_zh": "技术迭代快；更看重学习速度、抽象与与 AI 协作的学习方式。",
      "level2": [
        {
          "id": "learn_apply",
          "title_zh": "学习与应用速度",
          "title_en": "Learn & apply",
