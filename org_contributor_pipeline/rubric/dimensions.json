        },
        {
          "id": "continuity_passion",
          "title_zh": "持续成长与投入",
          "title_en": "Continuity",
          "observable_zh": "复盘、培训、技术债偿还、职级目标对齐。"
        },
        {
          "id": "ai_collaboration",
          "title_zh": "AI 协作与风控",
          "title_en": "AI collaboration",
          "observable_zh": "提示与审查 AI 产出、流程嵌入与质量/合规边界。"
        }
      ]
    }
  ]
