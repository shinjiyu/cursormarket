{
  "schema_version": 3,
  "title": "程序员能力考核 — 两级维度（参考精神、可落地版）",
  "notes_zh": "与老板口述的八大方向对齐，但不逐字等价：L2 已合并、收束，便于后续按插件/MR/面试逐项填证据；Git 与静态分析只能覆盖少数代理信号，须标注置信度。必审三大 L1（基础技术能力、工程能力、系统设计能力）的证据口径与阶段输出要求见同目录 review_framework.json（非仅靠插件）。",
  "level1": [
    {
      "id": "technical_fundamentals",
      "title_zh": "基础技术能力",
      "title_en": "Technical Fundamentals",
      "spirit_zh": "硬实力：不止会调 API，能讲清原理、trade-off 与 root cause。",
      "observation_zh": "复杂度与正确性、语言与运行栈、数据与并发、是否能量化风险。",
      "level2": [
        {
          "id": "cs_complexity",
          "title_zh": "数据结构、算法与复杂度",
          "title_en": "CS & complexity",
          "observable_zh": "关键路径上的选型、边界分析、CR/面试中的讨论。"
        },
        {
          "id": "language_runtime",
          "title_zh": "语言深度与运行栈",
          "title_en": "Language & runtime",
          "observable_zh": "语言特性、内存/生命周期、OS/网络/并发与排障链（可合并举证）。"
        },
        {
          "id": "data_storage",
          "title_zh": "数据与持久化",
          "title_en": "Data & storage",
          "observable_zh": "模型、事务、索引、迁移与一致性取舍。"
        },
        {
          "id": "design_tooling",
          "title_zh": "设计表达与工程化底座",
          "title_en": "Design & tooling",
          "observable_zh": "设计模式是否服务可读性/演进；构建、依赖、环境可复现。"
        }
      ]
    },
    {
      "id": "engineering_ability",
      "title_zh": "工程能力",
      "title_en": "Engineering Ability",
      "spirit_zh": "能跑不够：可维护、可交接、线上可查——高级工程师常在这里拉开差距。",
      "boss_focus_zh": "半年后好不好改、新人好不好接、崩了好不好查。",
      "level2": [
        {
          "id": "structure_modularity",
          "title_zh": "结构、模块化与解耦",
          "title_en": "Structure & modularity",
          "observable_zh": "分层、边界、依赖方向、扩展点与循环依赖治理。"
        },
        {
          "id": "maintainability",
          "title_zh": "可维护性与演进",
          "title_en": "Maintainability",
          "observable_zh": "重构节奏、技术债显式化、修改成本与阅读成本。"
        },
        {
          "id": "quality_gates",
          "title_zh": "规范与质量门禁",
          "title_en": "Quality gates",
          "observable_zh": "Lint/风格/分支规范、单测与关键路径覆盖趋势。"
        },
        {
          "id": "cicd_release",
          "title_zh": "CI/CD 与发布",
          "title_en": "CI/CD",
          "observable_zh": "流水线稳定性、门禁、发布/回滚节奏。"
        },
        {
          "id": "observability_debug",
          "title_zh": "可观测性与排障",
          "title_en": "Observability & debug",
          "observable_zh": "日志/指标/追踪、线上定位链、最小复现与工具化。"
        },
        {
          "id": "vcs_footprint",
          "title_zh": "版本库活动与可追溯（Git 代理）",
          "title_en": "VCS footprint (proxy)",
          "observable_zh": "来自 commit：频率、活跃日、title/web_url、变更体量；须与 CR/MR 交叉，不等价工程能力。",
          "plugin_note": "由插件 delivery_traceability 写入指标。"
        }
      ]
    },
    {
      "id": "system_design",
      "title_zh": "系统设计能力",
      "title_en": "System Design",
      "spirit_zh": "越高级越重：能取舍、控复杂度与成本，而不是堆组件。",
      "observation_zh": "何时不该上某技术；故障域、一致性、成本是否入脑。",
